# Copy this file to .env and fill it in. Never commit .env.
# Gmail address that sends the assessment form emails
EMAIL_USER=
# Gmail App Password for that address (https://myaccount.google.com/apppasswords), not the login password
EMAIL_PASS=
# Address that receives each assessment request
EMAIL_TO=
# Port to run on (hosts usually set this themselves; defaults to 8080)
PORT=3000
